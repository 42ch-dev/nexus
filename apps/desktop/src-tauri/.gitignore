# Tauri build artifacts (standalone crate — NOT in the root Cargo workspace).
/target
/gen

# P1 sidecar binaries (target-triple-suffixed). The placeholder README stays.
/binaries/*
!/binaries/README.md

# App icons: only icons/source/ and icons/README.md are tracked. Desktop formats
# are generated at build/dev time — see icons/README.md and package.json icons:generate.
