{
  "name": "nexus-desktop-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus unsigned Electron desktop shell for macOS arm64 and x64",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json",
    "dev": "node scripts/dev.mjs --mode dist",
    "dev:web": "node scripts/dev.mjs --mode web",
    "package": "node scripts/package.mjs",
    "proof:native-smoke": "node src/native-smoke.mjs",
    "test:lifecycle": "pnpm run build && node --test tests/lifecycle-harness.mjs",
    "icons": "node scripts/compose-app-icon.mjs"
  },
  "dependencies": {
    "@42ch/nexus-contracts": "workspace:*",
    "@42ch/nexus-native": "workspace:*",
    "@42ch/nexus-provider-acp": "workspace:*",
    "@42ch/nexus-service": "workspace:*",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^26.6.1",
    "electron": "44.4.1",
    "sharp": "0.35.4"
  }
}
