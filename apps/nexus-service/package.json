{
  "name": "@42ch/nexus-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Node HTTP service over @42ch/nexus-native (v1.189 P4-T1)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/main.ts",
    "start": "node dist/main.js",
    "proof:open-smoke": "node src/open-smoke.mjs"
  },
  "dependencies": {
    "@42ch/nexus-contracts": "workspace:*",
    "@42ch/nexus-native": "workspace:*",
    "@42ch/nexus-provider-acp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22.22"
  }
}
