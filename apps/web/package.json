{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "description": "Nexus local Web UI — Control Room + Setup SPA (browser + Electron desktop host)",
  "author": "42ch",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @42ch/nexus-contracts run build && pnpm --filter @42ch/nexus-ui run build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm --filter @42ch/nexus-contracts run build && pnpm --filter @42ch/nexus-ui run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@42ch/nexus-contracts": "workspace:*",
    "@42ch/nexus-ui": "workspace:*",
    "@dagrejs/dagre": "^3.1.1",
    "@nexus/design-tokens": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tiptap/react": "^3.30.4",
    "@tiptap/starter-kit": "^3.30.4",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "react-window": "^2.3.2",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.22",
    "pnpm": ">=8.0.0"
  }
}
