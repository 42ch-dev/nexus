{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "description": "Nexus local Web UI — Control Room + Setup SPA (browser + Electron desktop host)",
  "author": "42ch",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @42ch/nexus-contracts run build && pnpm --filter @42ch/nexus-ui run build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm --filter @42ch/nexus-contracts run build && pnpm --filter @42ch/nexus-ui run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@42ch/nexus-contracts": "workspace:*",
    "@42ch/nexus-ui": "workspace:*",
    "@dagrejs/dagre": "^3.1.3",
    "@nexus/design-tokens": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "react-window": "^2.5.3",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.22",
    "pnpm": ">=8.0.0"
  }
}
