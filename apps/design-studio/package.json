{
  "name": "design-studio",
  "private": true,
  "version": "0.0.0",
  "description": "Nexus Design Studio — standalone DESIGN SSOT gallery and UI primitive showcase",
  "author": "42ch",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @nexus/design-tokens generate && pnpm --filter @42ch/nexus-ui build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@42ch/nexus-ui": "workspace:*",
    "@nexus/design-tokens": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.41.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^15.0.1",
    "react-router": "^8.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22",
    "pnpm": ">=8.0.0"
  }
}
