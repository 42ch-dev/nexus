{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases (match vite.config.ts) */
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/utils": ["../web/src/lib/utils.ts"],
      "@web-locales/en": ["../web/src/locales/en"],
      "@/components/ui/*": ["../web/src/components/ui/*"],
      "@web-ui/*": ["../web/src/components/ui/*"],
      "@web-setup/*": ["../web/src/components/setup/*"],
      "@web-layout/*": ["../web/src/components/layout/presentational/*"],
      "@web-settings/*": ["../web/src/components/settings/presentational/*"],
      "@web-canvas/*": ["../web/src/components/canvas/presentational/*"],
      "@web-global-timeline/*": [
        "../web/src/components/global-timeline/presentational/*"
      ],
      "@web-lib/utils": ["../web/src/lib/utils.ts"],
      "@web-shell/*": ["../web/src/components/selection-submenu/*"]
    },

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src", "vite.config.ts"]
}
