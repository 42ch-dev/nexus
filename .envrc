# Nexus-only: scoped Rust target across main checkout and git worktrees.
# Enable once per checkout: direnv allow
# Do not set target-dir in ~/.cargo/config.toml — that affects all Rust projects.
#
# Layout:
#   Main checkout / integration worktree → ~/.cache/nexus-target          (canonical, no suffix)
#   Feature worktree (.worktrees/<name>) → ~/.cache/nexus-target-<name>   (isolated, clean after merge)
#
# Cleanup after merge:  rm -rf ~/.cache/nexus-target-<name>
# Clean all features:   rm -rf ~/.cache/nexus-target-*

_nexus_wt_file=.git
if [ -f "$_nexus_wt_file" ] && grep -qs 'worktrees' "$_nexus_wt_file"; then
    _nexus_dir=$(basename "$PWD")
    case "$_nexus_dir" in
        iteration-*)
            # Integration worktree — canonical shared target (merge target)
            export CARGO_TARGET_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/nexus-target"
            ;;
        *)
            # Feature worktree — isolated target (clean after merge)
            export CARGO_TARGET_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/nexus-target-${_nexus_dir}"
            ;;
    esac
    unset _nexus_dir
else
    # Main checkout — canonical shared target
    export CARGO_TARGET_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/nexus-target"
fi
unset _nexus_wt_file
