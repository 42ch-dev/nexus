# Nexus-only: one scoped Rust target per checkout.
# Enable once per checkout: direnv allow
# Do not set target-dir in ~/.cargo/config.toml — that affects all Rust projects.
#
# Layout:
#   Main checkout                       → ~/.cache/nexus-target           (canonical, no suffix)
#   Any worktree (.worktrees/<name>)    → ~/.cache/nexus-target-<name>    (isolated, clean after merge)
#
# No two checkouts share a target dir — not even the integration worktree,
# which keeps its own `nexus-target-iteration-<id>`. Cargo's fingerprint records
# the target directory and the package, never which checkout produced the
# bytes, so a shared dir serves one checkout's fresh-looking rmeta to another's
# build. Verify with tooling/check-target-dir.sh after `direnv allow`.
#
# Before merge, remove only the stopped track's verified exact
# ${XDG_CACHE_HOME:-$HOME/.cache}/nexus-target-<name>; never glob active targets.

if [ -f .git ] && grep -qs 'worktrees' .git; then
    # Linked worktree — isolated target (clean after merge)
    export CARGO_TARGET_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/nexus-target-$(basename "$PWD")"
else
    # Main checkout — canonical target
    export CARGO_TARGET_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/nexus-target"
fi
