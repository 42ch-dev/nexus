{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "warn",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/unbound-method": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-floating-promises": "off",
    "typescript/restrict-template-expressions": "off",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "prefer-const": "error",
    "no-var": "error"
  },
  "overrides": [
    {
      "files": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "rules": {
        "typescript/ban-ts-comment": "off",
        "typescript/no-unused-vars": "off",
        "no-unused-vars": "off",
        "typescript/no-base-to-string": "off",
        "no-unsafe-optional-chaining": "off"
      }
    },
    {
      "files": [
        "tooling/validation/schema-validator.js",
        "tooling/design-tokens/scripts/**",
        "tooling/codegen/src/utils.ts",
        "apps/desktop/src-tauri/icons/source/compose-app-icon.mjs"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "apps/web/src/components/canvas/world-kb/graph-projection.ts",
        "apps/web/src/components/canvas/world-kb/relationship-inspector-logic.ts",
        "apps/web/src/components/memory/pending-reviews-section.tsx",
        "apps/web/src/components/soul/soul-narrative-card.tsx"
      ],
      "rules": {
        "typescript/no-redundant-type-constituents": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/out/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.config.js",
    "**/*.config.cjs",
    "**/*.config.mjs",
    "packages/nexus-contracts/src/generated/**",
    "crates/**"
  ]
}
