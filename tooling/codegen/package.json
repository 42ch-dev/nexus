{
  "name": "nexus-codegen",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Nexus schema-to-code generation pipeline (TS + Rust)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "codegen": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.0.0",
    "glob": "^11.0.0",
    "json-schema-to-typescript": "^15.0.0"
  },
  "devDependencies": {
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "tsup": "^8.0.0",
    "@types/node": "^20.10.0",
    "vitest": "^3.2.6"
  }
}
