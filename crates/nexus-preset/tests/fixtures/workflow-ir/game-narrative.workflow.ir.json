  "effect_summary": "external",
  "entry": "routing",
  "id": "game-narrative",
  "initial_action": {
    "kind": "seed_direct"
  },
  "ir_version": 0,
  "meta": {
    "description": "Game narrative import: game-event (trigger) and interval-sweep (scheduled) lanes extracting worldview/character KnowledgeEntry drafts + Relation hints",
    "kind": "creator",
    "requires_capabilities": [
      "acp.prompt",
      "creator.inject_prompt",
      "judge.llm"
    ],
    "run_intents": [
      "knowledge_ingest"
    ]
  },
  "nests": [],
  "nodes": [
    {
      "effect_class": "external",
      "exit_when": {
        "judge_capability": "judge.llm",
        "kind": "llm_judge",
        "template": "templates/lane-route.md"
      },
      "id": "routing",
      "kind": "outer_state",
      "ui": {
        "description": "Lane selector: judge reads preset.input.mode -> scheduled sweep (GO) or game-event trigger (NOGO)"
      }
    },
    {
      "effect_class": "external",
      "enter": [
        {
          "kind": "inner_graph",
          "name": "trigger_graph"
        }
      ],
      "exit_when": {
        "kind": "graph_complete"
      },
      "id": "trigger_extract",
      "kind": "outer_state",
      "ui": {
        "description": "Trigger lane: game event -> extraction/assembly task"
      }
    },
    {
      "effect_class": "external",
      "enter": [
        {
          "args": {
            "prompt_file": "templates/scheduled-sweep.md"
          },
          "kind": "capability",
          "name": "creator.inject_prompt"
        }
      ],
      "exit_when": {
        "judge_capability": "judge.llm",
        "kind": "llm_judge",
        "min_interval": "PT1H",
        "template": "templates/scheduled-sweep-exit.md"
      },
      "id": "scheduled_sweep",
      "kind": "outer_state",
      "ui": {
        "description": "Scheduled lane: inventory new/changed worldview + character documents and judge whether to import (scan state — extraction is a separate state)"
      }
    },
    {
      "effect_class": "external",
      "enter": [
        {
          "kind": "inner_graph",
          "name": "sweep_graph"
        }
      ],
      "exit_when": {
        "kind": "graph_complete"
      },
      "id": "sweep_extract",
      "kind": "outer_state",
      "ui": {
        "description": "Scheduled lane extraction: worldview/character KnowledgeEntry drafts + Relation hints (runs only after the sweep judge says GO)"
      }
    },
    {
      "effect_class": "pure",
      "id": "done",
      "kind": "terminal"
    },
    {
      "effect_class": "external",
      "id": "sweep_graph/extract_worldview",
      "kind": "inner_step",
      "step_kind": "acp_prompt",
      "template": "templates/import-worldview.md",
      "tool_policy": "auto_grant_read_only"
    },
    {
      "depends_on": [
        "sweep_graph/extract_worldview"
      ],
      "effect_class": "external",
      "id": "sweep_graph/extract_characters",
      "kind": "inner_step",
      "output_binding": "extract_characters.text",
      "step_kind": "acp_prompt",
      "template": "templates/import-character-sheet.md",
      "tool_policy": "auto_grant_read_only"
    },
    {
      "effect_class": "external",
      "id": "trigger_graph/trigger_parse",
      "kind": "inner_step",
      "step_kind": "acp_prompt",
      "template": "templates/trigger-game-event.md",
      "tool_policy": "auto_grant_read_only"
    },
    {
      "depends_on": [
        "trigger_graph/trigger_parse"
      ],
      "effect_class": "external",
      "id": "trigger_graph/extract_worldview",
      "kind": "inner_step",
      "step_kind": "acp_prompt",
      "template": "templates/import-worldview.md",
      "tool_policy": "auto_grant_read_only"
    },
    {
      "depends_on": [
        "trigger_graph/extract_worldview"
      ],
      "effect_class": "external",
      "id": "trigger_graph/extract_characters",
      "kind": "inner_step",
      "output_binding": "extract_characters.text",
      "step_kind": "acp_prompt",
      "template": "templates/import-character-sheet.md",
      "tool_policy": "auto_grant_read_only"
    }
  ],
