  "effect_summary": "external",
  "entry": "intake",
  "id": "essay-writing",
  "ir_version": 0,
  "meta": {
    "description": "LLM-driven essay drafting + 4-dimension quality rubric (thesis clarity, evidence support, coherence, ending takeaway) for essay Works (V1.63: Depth 3.5)",
    "gates": [
      {
        "field": "work_profile",
        "kind": "work_field",
        "op": "equals",
        "value": "essay"
      },
      {
        "field": "work_ref",
        "kind": "work_field",
        "op": "required"
      },
      {
        "field": "intake_status",
        "kind": "work_field",
        "op": "equals",
        "value": "complete"
      },
      {
        "kind": "filesystem",
        "must_exist": true,
        "path": "Works/{{work_ref}}/Drafts/"
      }
    ],
    "kind": "creator",
    "requires_capabilities": [
      "creator.inject_prompt",
      "acp.prompt",
      "judge.llm",
      "essay.draft_status.finalize"
    ],
    "run_intents": [
      "work_continue"
    ]
  },
  "nests": [],
