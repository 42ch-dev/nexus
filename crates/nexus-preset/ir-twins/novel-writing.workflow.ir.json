  "effect_summary": "external",
  "entry": "outline_chapter",
  "id": "novel-writing",
  "ir_version": 0,
  "meta": {
    "description": "Per-chapter outline → draft → finalize pipeline; gated by llm_judge 五問 quality checks at outline and finalize",
    "gates": [
      {
        "field": "work_profile",
        "kind": "work_field",
        "op": "equals",
        "value": "novel"
      },
      {
        "field": "work_ref",
        "kind": "work_field",
        "op": "required"
      },
      {
        "field": "intake_status",
        "kind": "work_field",
        "op": "equals",
        "value": "complete"
      },
      {
        "kind": "filesystem",
        "must_exist": true,
        "path": "Works/{{work_ref}}/"
      },
      {
        "kind": "filesystem",
        "must_exist": true,
        "path": "Works/{{work_ref}}/Outlines/"
      },
      {
        "kind": "filesystem",
        "must_exist": true,
        "path": "Works/{{work_ref}}/Stories/"
      },
      {
        "kind": "previous_preset",
        "preset": "novel-project-init",
        "scope": "work",
        "status": "complete"
      }
    ],
    "kind": "creator",
    "requires_capabilities": [
      "creator.inject_prompt",
      "acp.prompt",
      "judge.llm",
      "novel.chapter_transition"
    ],
    "run_intents": [
      "work_continue"
    ]
  },
  "nests": [],
  "nodes": [
    {
      "effect_class": "external",
      "enter": [
        {
          "args": {
            "prompt_file": "prompts/outline-chapter.md",
            "vars": {
              "chapter": "{{preset.input.chapter}}",
              "chapter_label": "{{preset.input.chapter_label}}",
              "foreshadowing_summary": "{{preset.input.foreshadowing_summary}}",
              "open_findings_block": "{{preset.input.open_findings_block}}",
              "outline_path": "{{preset.input.outline_path}}",
              "slug": "{{preset.input.slug}}",
              "topic": "{{preset.input.topic}}",
              "vibe": "{{preset.input.vibe}}",
              "work_id": "{{preset.input.work_id}}",
              "work_ref": "{{preset.input.work_ref}}",
              "world_kb_block": "{{preset.input.world_kb_block}}"
            }
          },
          "kind": "capability",
          "name": "creator.inject_prompt"
        }
      ],
      "exit_when": {
        "kind": "manual"
      },
      "id": "outline_chapter",
      "kind": "outer_state",
      "ui": {
        "description": "Write chapter outline (uses chapter-outline.md template)"
      }
    },
    {
      "effect_class": "external",
      "exit_when": {
        "judge_capability": "judge.llm",
        "kind": "llm_judge",
        "min_interval": "PT6H",
        "template": "prompts/outline-exit.md"
      },
      "id": "outline_review",
      "kind": "outer_state",
      "ui": {
        "description": "Run outline 五问 quality gate; NOGO returns WaitForInput (no state mutation in enter)"
      }
    },
    {
      "effect_class": "external",
      "enter": [
        {
          "args": {
            "prompt_file": "prompts/draft-chapter.md",
            "vars": {
              "body_path": "{{preset.input.body_path}}",
              "chapter": "{{preset.input.chapter}}",
              "chapter_label": "{{preset.input.chapter_label}}",
              "foreshadowing_summary": "{{preset.input.foreshadowing_summary}}",
              "open_findings_block": "{{preset.input.open_findings_block}}",
              "outline_path": "{{preset.input.outline_path}}",
              "slug": "{{preset.input.slug}}",
              "topic": "{{preset.input.topic}}",
              "vibe": "{{preset.input.vibe}}",
              "work_id": "{{preset.input.work_id}}",
              "work_ref": "{{preset.input.work_ref}}",
              "world_kb_block": "{{preset.input.world_kb_block}}"
            }
          },
          "kind": "capability",
          "name": "creator.inject_prompt"
        },
        {
          "args": {
            "chapter": "{{preset.input.chapter}}",
            "from_status": "outlined",
            "to_status": "draft",
            "work_id": "{{preset.input.work_id}}"
          },
          "kind": "capability",
          "name": "novel.chapter_transition"
        }
      ],
      "exit_when": {
        "kind": "manual"
      },
      "id": "draft_chapter",
      "kind": "outer_state",
      "ui": {
        "description": "Draft chapter body (uses chapter-body.md template; frontmatter status: draft)"
      }
    },
    {
      "effect_class": "external",
      "exit_when": {
        "judge_capability": "judge.llm",
        "kind": "llm_judge",
        "min_interval": "PT6H",
        "template": "prompts/finalize-exit.md"
      },
      "id": "finalize",
      "kind": "outer_state",
      "ui": {
        "description": "Run llm_judge 五問 quality gate on the draft; NOGO returns WaitForInput (no state mutation in enter)"
      }
    },
    {
      "effect_class": "external",
      "enter": [
        {
          "args": {
            "chapter": "{{preset.input.chapter}}",
            "from_status": "draft",
            "to_status": "finalized",
            "work_id": "{{preset.input.work_id}}"
          },
          "kind": "capability",
          "name": "novel.chapter_transition"
        }
      ],
      "id": "finalize_commit",
      "kind": "outer_state",
      "ui": {
        "description": "Chapter 五問 gate passed; flip work_chapters row + frontmatter to finalized"
      }
    },
    {
      "effect_class": "pure",
      "id": "done",
      "kind": "terminal"
    }
  ],
  "provenance": {
    "source": "import_preset"
