{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus42.invalid/schemas/core/provider-host-event.schema.json",
  "schema_version": 1,
  "title": "Nexus ProviderHostEvent",
  "description": "Externally tagged provider host event union promoted from handwritten HostEvent serde.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": ["SessionCreated"],
      "additionalProperties": false,
      "properties": {
        "SessionCreated": {
          "type": "object",
          "required": ["session_id", "provider_id"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": "string" },
            "provider_id": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["OpStarted"],
      "additionalProperties": false,
      "properties": {
        "OpStarted": {
          "type": "object",
          "required": ["session_id", "op_id"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": "string" },
            "op_id": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["ThoughtDelta"],
      "additionalProperties": false,
      "properties": {
        "ThoughtDelta": {
          "type": "object",
          "required": ["session_id", "op_id", "text"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": "string" },
            "op_id": { "type": "string" },
            "text": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["MessageDelta"],
      "additionalProperties": false,
      "properties": {
        "MessageDelta": {
          "type": "object",
          "required": ["session_id", "op_id", "text"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": "string" },
            "op_id": { "type": "string" },
            "text": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["ToolCall"],
      "additionalProperties": false,
      "properties": {
        "ToolCall": {
          "type": "object",
          "required": ["session_id", "op_id", "tool_call_id", "tool_name"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": "string" },
            "op_id": { "type": "string" },
            "tool_call_id": { "type": "string" },
            "tool_name": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["ToolCallUpdate"],
      "additionalProperties": false,
      "properties": {
        "ToolCallUpdate": {
          "type": "object",
          "required": ["session_id", "op_id", "tool_call_id", "content"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": "string" },
            "op_id": { "type": "string" },
            "tool_call_id": { "type": "string" },
            "content": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["PlanUpdate"],
      "additionalProperties": false,
      "properties": {
        "PlanUpdate": {
          "type": "object",
          "required": ["session_id", "op_id", "content"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": "string" },
            "op_id": { "type": "string" },
            "content": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["Status"],
      "additionalProperties": false,
      "properties": {
        "Status": {
          "type": "object",
          "required": ["session_id", "level", "message"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": ["string", "null"] },
            "level": { "type": "string", "enum": ["info", "warning", "error"] },
            "message": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["OpFinished"],
      "additionalProperties": false,
      "properties": {
        "OpFinished": {
          "type": "object",
          "required": ["session_id", "op_id", "reason"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": "string" },
            "op_id": { "type": "string" },
            "reason": {
              "type": "string",
              "enum": ["end_turn", "max_tokens", "max_turn_requests", "refusal", "cancelled"]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["OpFailed"],
      "additionalProperties": false,
      "properties": {
        "OpFailed": {
          "type": "object",
          "required": ["session_id", "op_id", "error_category", "error_message"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": "string" },
            "op_id": { "type": "string" },
            "error_category": { "type": "string" },
            "error_message": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["SessionStopped"],
      "additionalProperties": false,
      "properties": {
        "SessionStopped": {
          "type": "object",
          "required": ["session_id", "reason"],
          "additionalProperties": false,
          "properties": {
            "session_id": { "type": "string" },
            "reason": {
              "type": "string",
              "enum": ["graceful_shutdown", "provider_exit", "error", "cancelled"]
            }
          }
        }
      }
    }
  ]
}
