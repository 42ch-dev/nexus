{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus42.invalid/schemas/core/core-provider-journal-write.schema.json",
  "schema_version": 1,
  "title": "Nexus CoreProviderJournalWrite",
  "description": "Owned write command for the durable JS-provider operation journal, replacing direct pool SQL. The sequence is assigned by the store; an already-terminal row is never downgraded.",
  "type": "object",
  "required": [
    "operation_id",
    "session_id",
    "provider_id",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "finished",
        "failed",
        "interrupted",
        "cancelled"
      ]
    }
  }
}
