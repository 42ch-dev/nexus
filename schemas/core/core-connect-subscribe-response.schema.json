{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core-connect-subscribe-response.schema.json",
  "title": "Core Connect Subscribe Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["stream", "epoch", "resumed_from"],
  "properties": {
    "stream": { "type": "string", "minLength": 1 },
    "epoch": { "type": "string", "format": "uuid" },
    "resumed_from": { "type": ["string", "null"] }
  }
}
