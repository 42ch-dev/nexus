{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus42.invalid/schemas/core/core-connect-invoke-response.schema.json",
  "schema_version": 1,
  "title": "Nexus CoreConnectInvokeResponse",
  "description": "Canonical Connect invoke result envelope: exactly one of result or error is non-null. Error codes reuse the shared CoreError categories, including unsupported operations.",
  "type": "object",
  "required": [
    "result",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Operation result; null on failure."
    },
    "error": {
      "anyOf": [
        {
          "$ref": "https://nexus42.invalid/schemas/core/core-error.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Wire error envelope; null on success."
    }
  }
}
