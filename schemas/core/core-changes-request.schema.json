{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus42.invalid/schemas/core/core-changes-request.schema.json",
  "schema_version": 1,
  "title": "Nexus CoreChangesRequest",
  "type": "object",
  "required": ["after_sequence"],
  "additionalProperties": false,
  "properties": {
    "after_sequence": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Non-negative decimal string cursor (exclusive lower bound)."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256,
      "default": 64
    }
  }
}
