{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus42.invalid/schemas/core/provider-reply.schema.json",
  "schema_version": 1,
  "title": "Nexus ProviderReply",
  "description": "Provider call reply envelope. Execute returns operation_id only, never the full transcript.",
  "type": "object",
  "required": ["request_id", "ok"],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string" },
    "ok": { "type": "boolean" },
    "operation_id": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "health": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider_id": { "type": "string" },
        "available": { "type": "boolean" },
        "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
        "message": { "type": ["string", "null"] }
      },
      "required": ["provider_id", "available"]
    },
    "error": { "$ref": "core-error.schema.json" }
  }
}
