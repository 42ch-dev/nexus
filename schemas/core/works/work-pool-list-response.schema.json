    "$ref": "https://nexus42.invalid/schemas/core/works/work-pool-entry.schema.json"
   }
  },
  "total": {
   "type": "integer",
   "minimum": 0
  },
  "limit": {
   "type": "integer",
   "minimum": 0
  },
  "offset": {
   "type": "integer",
   "minimum": 0
  }
 }
}
