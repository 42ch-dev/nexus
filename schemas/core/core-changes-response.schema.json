{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus42.invalid/schemas/core/core-changes-response.schema.json",
  "schema_version": 1,
  "title": "Nexus CoreChangesResponse",
  "type": "object",
  "required": ["rows", "next_sequence", "snapshot_sequence", "resync_required"],
  "additionalProperties": false,
  "properties": {
    "rows": {
      "type": "array",
      "items": { "$ref": "core-change-row.schema.json" }
    },
    "next_sequence": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Decimal string sequence watermark after this page."
    },
    "snapshot_sequence": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "High-water snapshot sequence at read time."
    },
    "resync_required": { "type": "boolean" }
  }
}
