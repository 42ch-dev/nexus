{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus42.invalid/schemas/daemon-api/agent-host/character-run-capture-outcome.schema.json",
  "schema_version": 1,
  "title": "Nexus CharacterRunCaptureOutcome",
  "description": "Terminal or initial capture observation for a Character Host operation. Required nullable members avoid ambiguous absence on the wire.",
  "type": "object",
  "required": ["status", "pending_id", "code"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["disabled", "pending", "captured", "skipped", "failed"]
    },
    "pending_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "code": {
      "type": ["string", "null"],
      "enum": [
        "run_incomplete",
        "run_failed",
        "run_cancelled",
        "capture_too_large",
        "capture_empty_output",
        "capture_scope_changed",
        "capture_store_failed",
        null
      ]
    }
  }
}
