{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus42.invalid/schemas/daemon-api/schedule/signal-schedule-request.schema.json",
  "schema_version": 1,
  "title": "Nexus SignalScheduleRequest",
  "description": "Request body for POST /v1/daemon/orchestration/schedules/{schedule_id}/signal.",
  "type": "object",
  "required": ["signal"],
  "properties": {
    "signal": { "type": "string", "description": "Signal action: pause, resume, cancel, start, advance, continue." },
    "wait_id": { "type": "string", "description": "Exact durable wait token for continue (A4). Required for signal=continue; ignored for other signals." }
  },
  "additionalProperties": false
}
