{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus42.invalid/schemas/daemon-api/characters/add-character-binding-request.schema.json",
  "schema_version": 1,
  "title": "Nexus AddCharacterBindingRequest",
  "description": "Request body for POST /v1/daemon/characters/:character_id/bindings. Clients never send owner_creator_id.",
