    "world_id"
  ],
  "additionalProperties": false,
  "properties": {
    "world_id": {
      "$ref": "https://nexus42.invalid/schemas/common/common.schema.json#/definitions/WorldId"
    },
    "world_sheet_entry_id": {
      "type": "string",
      "description": "Optional WorldSheet KnowledgeEntry id."
    }
  }
}
