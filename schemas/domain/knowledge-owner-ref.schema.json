{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus42.invalid/schemas/domain/knowledge-owner-ref.schema.json",
  "schema_version": 1,
  "title": "Nexus KnowledgeOwnerRef",
  "description": "Closed canonical KnowledgeEntry owner union: World | Character | ActorWorldBinding. Wire shape matches the domain KnowledgeOwnerRef (kind + id).",
  "type": "object",
  "oneOf": [
    {
      "title": "WorldKnowledgeOwner",
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^world$",
          "description": "World-owned KnowledgeEntry."
        },
        "id": {
          "$ref": "https://nexus42.invalid/schemas/common/common.schema.json#/definitions/WorldId"
        }
      }
    },
    {
      "title": "CharacterKnowledgeOwner",
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^character$",
          "description": "Character-owned KnowledgeEntry shared across active bindings."
        },
        "id": {
          "$ref": "https://nexus42.invalid/schemas/common/common.schema.json#/definitions/CharacterId"
        }
      }
    },
    {
      "title": "BindingKnowledgeOwner",
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^actor_world_binding$",
          "description": "Binding-local KnowledgeEntry isolated to one ActorWorldBinding."
        },
        "id": {
          "$ref": "https://nexus42.invalid/schemas/common/common.schema.json#/definitions/ActorWorldBindingId"
        }
      }
    }
  ]
}
