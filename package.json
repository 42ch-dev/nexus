{
  "name": "nexus-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus open-source monorepo - CLI, daemon, and wire contracts",
  "author": "42ch",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/42ch/nexus"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {},
  "pnpm": {
    "overrides": {
      "fast-uri": ">= 3.1.1",
      "esbuild": "^0.28.1"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter '!desktop' run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "validate-schemas": "pnpm -F nexus-schema-validator validate",
    "codegen": "pnpm -F nexus-codegen build && pnpm -F nexus-codegen codegen && pnpm -F @42ch/nexus-contracts build",
    "codegen:watch": "pnpm -F nexus-codegen build && pnpm -F nexus-codegen dev",
    "publish:contracts": "pnpm -F @42ch/nexus-contracts publish:public",
    "sidecar": "bash scripts/fetch-sidecar.sh",
    "dev:design-studio": "pnpm -F design-studio dev",
    "dev:web": "pnpm -F web dev",
    "dev:desktop": "pnpm -F desktop dev",
    "build:design-studio": "pnpm -F design-studio build",
    "build:web": "pnpm -F web build",
    "build:desktop": "pnpm -F desktop build",
    "test:design-studio": "pnpm -F design-studio test",
    "test:web": "pnpm -F web test",
    "build:cli": "cargo build -p nexus42",
    "build:cli:release": "cargo build -p nexus42 --release"
  }
}
