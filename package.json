{
  "name": "nexus-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus open-source monorepo - CLI, daemon, and wire contracts",
  "author": "42ch",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/42ch/nexus"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {},
  "pnpm": {
    "overrides": {
      "fast-uri": ">= 3.1.1",
      "esbuild": "^0.28.1"
    }
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "validate-schemas": "node tooling/validation/schema-validator.js",
    "codegen": "pnpm --filter nexus-codegen run build && pnpm --filter nexus-codegen run codegen && pnpm --filter @42ch/nexus-contracts run build",
    "codegen:watch": "pnpm --filter nexus-codegen run build && pnpm --filter nexus-codegen run dev",
    "publish:contracts": "cd packages/nexus-contracts && pnpm run publish:public",
    "sidecar": "bash scripts/fetch-sidecar.sh",
    "build:contracts": "pnpm --filter @42ch/nexus-contracts run build",
    "build:ui": "pnpm --filter @42ch/nexus-ui run build",
    "dev:design-studio": "pnpm --filter design-studio dev",
    "dev:web": "pnpm --filter web dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "build:design-studio": "pnpm --filter design-studio build",
    "build:web": "pnpm --filter web build",
    "build:desktop": "pnpm --filter desktop build",
    "test:design-studio": "pnpm --filter design-studio test",
    "test:web": "pnpm --filter web test",
    "build:cli": "cargo build -p nexus42",
    "build:cli:release": "cargo build -p nexus42 --release"
  }
}
