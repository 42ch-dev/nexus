{
  "name": "@42ch/nexus-native",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus native core loader and TypeScript facade (v1.189 P2-T1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/callback-lifecycle.test.mjs tests/loader-negative.test.mjs tests/provider-tsfn-callback.test.mjs"
  },
  "dependencies": {
    "@42ch/nexus-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.1"
  },
  "optionalDependencies": {
    "@42ch/nexus-native-darwin-arm64": "0.1.0",
    "@42ch/nexus-native-darwin-x64": "0.1.0",
    "@42ch/nexus-native-linux-x64-gnu": "0.1.0",
    "@42ch/nexus-native-win32-x64-msvc": "0.1.0"
  },
  "engines": {
    "node": ">=22.22"
  }
}
