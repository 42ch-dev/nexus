{
  "name": "@42ch/nexus-ui",
  "version": "0.1.0",
  "description": "Nexus brand assets, design tokens, and theme helpers — framework-neutral, no React components in V1.83",
  "author": "42ch",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/42ch/nexus"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      }
    },
    "./theme.css": "./theme.css",
    "./assets/logos/logo-color.svg": "./assets/logos/logo-color.svg",
    "./assets/logos/logo-dark.svg": "./assets/logos/logo-dark.svg",
    "./assets/logos/logo-white.svg": "./assets/logos/logo-white.svg",
    "./assets/logos/logo-mono.svg": "./assets/logos/logo-mono.svg"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "theme.css",
    "README.md"
  ],
  "scripts": {
    "prepare": "pnpm run build",
    "build": "tsup src/index.ts src/tokens.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/tokens.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "nexus",
    "design-tokens",
    "brand",
    "assets"
  ]
}
