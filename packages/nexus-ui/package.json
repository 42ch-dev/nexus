{
  "name": "@42ch/nexus-ui",
  "version": "0.2.0",
  "description": "Nexus brand assets, design tokens, theme helpers, and React brand components (NexusLogo, NexusMark)",
  "author": "42ch",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/42ch/nexus"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "require": {
        "types": "./dist/tokens.d.cts",
        "default": "./dist/tokens.cjs"
      }
    },
    "./theme.css": "./theme.css",
    "./assets/logos/logo-color.svg": "./assets/logos/logo-color.svg",
    "./assets/logos/logo-primary.svg": "./assets/logos/logo-primary.svg",
    "./assets/logos/logo-white.svg": "./assets/logos/logo-white.svg",
    "./assets/logos/logo-mono.svg": "./assets/logos/logo-mono.svg"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "theme.css",
    "README.md"
  ],
  "scripts": {
    "prepare": "pnpm run build",
    "build": "tsup src/index.ts src/tokens.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/tokens.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "nexus",
    "design-tokens",
    "brand",
    "assets",
    "react",
    "components"
  ]
}
